# Copie para o painel do Render (backend). NUNCA commite valores reais.

# Banco (TiDB Cloud Starter). TiDB exige TLS.
DB_URL=jdbc:mysql://<host-tidb>:4000/<banco>?sslMode=VERIFY_IDENTITY&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8
DB_USER=<usuario-tidb>
DB_PASSWORD=<senha-tidb>

# Segurança
JWT_SECRET=<string aleatoria com pelo menos 32 bytes>
ADMIN_PASSWORD=<senha forte do administrador inicial>
ADMIN_EMAIL=<email do administrador>
ADMIN_NAME=<nome do administrador>

# Demo desligado em produção
DEMO_DATA=false

# Origem do frontend no Cloudflare Pages (sem barra no fim)
CORS_ORIGINS=https://<seu-projeto>.pages.dev
